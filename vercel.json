{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/#team",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/#team",
      "permanent": true
    },
    {
      "source": "/our-group",
      "destination": "/#team",
      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services/marketing-growth",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services/:slug*",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/#industries",
      "permanent": true
    },
    {
      "source": "/industries/:slug*",
      "destination": "/#industries",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/book-consultation",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/insights/founders-guide-saas-uae",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/insights/uae-investors-pitch-deck-2025",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/insights/seo-vs-aeo-dubai-2025",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/flags/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}